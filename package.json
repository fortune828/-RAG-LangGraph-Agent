{
  "name": "yijing-evidence-agent",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && .venv/bin/python -m backend",
    "build": "vite build",
    "start": ".venv/bin/python -m backend",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "corpus:build": "tsx scripts/build-corpus.ts",
    "eval": "tsx scripts/evaluate.ts",
    "eval:live": "tsx scripts/evaluate.ts --live",
    "knowledge:smoke": "tsx scripts/knowledge-smoke.ts",
    "test:browser": "node scripts/browser-smoke.mjs",
    "knowledge:build": "tsx scripts/knowledge/build.ts",
    "knowledge:audit": "tsx scripts/knowledge/audit.ts",
    "knowledge:correct": "tsx scripts/knowledge/apply-corrections.ts",
    "dev:legacy": "tsx server/index.ts",
    "start:legacy": "NODE_ENV=production tsx server/index.ts",
    "test:python": ".venv/bin/python -m pytest -q",
    "dev:ui": "vite"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "vite": "^6.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
