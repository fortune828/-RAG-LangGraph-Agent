# Server only: copy to .env.local. Never use a VITE_ prefix for secrets.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_THINKING=enabled
DEEPSEEK_MAX_TOKENS=8192
# Only sent when thinking=enabled; supported efforts: low, high, max.
DEEPSEEK_REASONING_EFFORT=low
# Lower-cost optional configuration: DEEPSEEK_THINKING=disabled and
# DEEPSEEK_MAX_TOKENS=4096. It is not the selected conversation-quality default.
PORT=3001
DATA_DIR=runtime

# Validation repair uses the same model, thinking disabled, max_tokens=8192.
